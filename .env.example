# Copy this file to .env and replace every placeholder before starting the service.
DATABASE_URL=postgresql://user:password@localhost:5432/multi_courier
PORT=3000
URBANEBOLT_BASE_URL=https://replace-with-urbanebolt-base-url.example
URBANEBOLT_USERNAME=replace-with-urbanebolt-username
URBANEBOLT_PASSWORD=replace-with-urbanebolt-password
REQUEST_TIMEOUT_MS=5000
RETRY_COUNT=2
RETRY_DELAY_MS=250
