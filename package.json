{
  "name": "multi-courier-integration-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for a multi-courier integration platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_ENV=test TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://user:password@localhost:5432/multi_courier} vitest run --passWithNoTests",
    "test:uat": "NODE_ENV=test RUN_URBANEBOLT_UAT=true TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://user:password@localhost:5432/multi_courier} vitest run tests/urbanebolt-uat-smoke.test.ts",
    "db:check": "tsx src/db/check.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rollback": "tsx src/db/rollback.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
